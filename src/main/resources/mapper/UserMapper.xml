<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sinka.platform.mapper.UserMapper">
    <insert id="creatUser">
        INSERT into users(username,password,nickname) values (#{username},#{password},#{nickname})
    </insert>

    <select id="selectUserByUsername"
            resultType="com.sinka.platform.entity.User">
        SELECT id, username, password
        FROM users
        WHERE username = #{username}
    </select>
    <select id="selectUserById" resultType="com.sinka.platform.entity.User">
        SELECT id, username, nickname, avatar_url
        FROM users
        WHERE id = #{id}
    </select>

</mapper>